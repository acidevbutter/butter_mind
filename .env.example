DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# Shared Postgres (infra/docker-compose.yml), same as the other services --
# no pgvector needed today (RAG_ENABLED=false, no vector columns in the schema).
# Settings assembles postgresql+asyncpg:// from these parts. DATABASE_URL is ignored.
DATABASE_HOST=shared-postgres
DATABASE_PORT=5432
DATABASE_USER=butter_mind
DATABASE_PASSWORD=butter_mind
DATABASE_NAME=butter_mind

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOWED_ORIGIN_REGEX=

# Maritaca AI (Sabiá models). The provider uses Responses API; stable
# instructions come before the dynamic conversation so prompt cache can apply.
# https://docs.maritaca.ai/pt/responses-api
MARITACA_API_KEY=
MARITACA_BASE_URL=https://chat.maritaca.ai/api
MARITACA_MODEL=sabiazinho-4-br-sp

# In-process sentence-transformers RAG. Keep false on CPU hosts; the
# diagnosis chat still works via Maritaca without grounding chunks.
RAG_ENABLED=false
EMBEDDINGS_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
EMBEDDINGS_DIMENSION=768

# Shared key gating internal endpoints (e.g. GET /diagnosis/requests, /knowledge/*)
INTERNAL_API_KEY=local-dev-mind-internal

# Shared key required on the public diagnosis/chat endpoints (proves the
# caller is devbutter_backend, not a browser hitting the API directly).
SERVICE_API_KEY=local-dev-mind-service
