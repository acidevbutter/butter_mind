DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# CloudWatch Embedded Metric Format. ECS uses the existing awslogs log group.
AWS_EMF_NAMESPACE=DevButter/ButterMind
AWS_EMF_SERVICE_NAME=butter_mind
AWS_EMF_LOG_GROUP_NAME=/ecs/devbutter/staging/mind
# Must stay "Local" everywhere (dev and ECS): metrics ship via the awslogs
# log driver -> CloudWatch Logs auto-extraction, not a CloudWatch Agent
# sidecar. Leaving this unset/empty makes the library autodetect and fall
# back to the "Agent" TCP sink, which silently drops every metric.
AWS_EMF_ENVIRONMENT=Local

DATABASE_URL=postgresql+asyncpg://butter_mind:butter_mind@db:5432/butter_mind

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOWED_ORIGIN_REGEX=

# Maritaca AI (Sabiá models). The provider uses Responses API; stable
# instructions come before the dynamic conversation so prompt cache can apply.
# https://docs.maritaca.ai/pt/responses-api
MARITACA_API_KEY=
MARITACA_BASE_URL=https://chat.maritaca.ai/api
MARITACA_MODEL=sabiazinho-4-br-sp

EMBEDDINGS_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
EMBEDDINGS_DIMENSION=768

# Shared key gating internal endpoints (e.g. GET /diagnosis/requests, /knowledge/*)
INTERNAL_API_KEY=

# Shared key required on the public diagnosis/chat endpoints (proves the
# caller is devbutter_backend, not a browser hitting the API directly).
SERVICE_API_KEY=
