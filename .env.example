DEBUG=false
LOG_LEVEL=INFO

# APM traces and metrics go directly to New Relic over OTLP/HTTP. Application
# logs stay human-readable on stdout and continue through the host collector.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=butter_mind
# Emit stable HTTP metrics with http.request.method, http.route and http.response.status_code.
OTEL_SEMCONV_STABILITY_OPT_IN=http
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=api-key=replace-with-new-relic-license-key
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION=base2_exponential_bucket_histogram
ENVIRONMENT=development

# Shared Postgres (infra/docker-compose.yml), same as the other services --
# no pgvector needed today (RAG_ENABLED=false, no vector columns in the schema).
# Settings assembles postgresql+asyncpg:// from these parts. DATABASE_URL is ignored.
DATABASE_HOST=shared-postgres
DATABASE_PORT=5432
DATABASE_USER=butter_mind
DATABASE_PASSWORD=butter_mind
DATABASE_NAME=butter_mind

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOWED_ORIGIN_REGEX=

# Maritaca AI (Sabiá models). The provider uses Responses API; stable
# instructions come before the dynamic conversation so prompt cache can apply.
# https://docs.maritaca.ai/pt/responses-api
MARITACA_API_KEY=
MARITACA_BASE_URL=https://chat.maritaca.ai/api
MARITACA_MODEL=sabiazinho-4-br-sp

# RAG grounding chunks. Embeddings are unplugged today (no API is called
# yet -- see app/core/embeddings/unplugged_provider.py), so keep this false;
# the diagnosis chat still works via Maritaca without grounding chunks.
RAG_ENABLED=false
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL_NAME=text-embedding-3-small
EMBEDDINGS_DIMENSION=768

# Shared key gating internal endpoints (e.g. GET /diagnosis/requests, /knowledge/*)
INTERNAL_API_KEY=local-dev-mind-internal

# Shared key required on the public diagnosis/chat endpoints (proves the
# caller is devbutter_backend, not a browser hitting the API directly).
SERVICE_API_KEY=local-dev-mind-service
